# ============================================================
# TrainMate v2 backend — environment template
# Copy to `.env` and adjust. `.env` is gitignored; this file is committed.
# ============================================================

# --- App ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (frontend dev server).
CORS_ORIGIN=http://localhost:5173

# --- Auth (validated by the service layer, Sprint 2B M3) ---
# HS256 signing key. REQUIRED, at least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# There is deliberately NO REFRESH_SECRET: refresh tokens are server-side
# opaque values (SHA-256 in Postgres), not JWTs (Auth-Design D-A11).
JWT_SECRET=
# Public origin of THIS api — the base of email confirmation links.
API_PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated origins that email-confirmation `redirect_to` may point at.
# Empty falls back to CORS_ORIGIN (Auth-Design §6.4 / D-A6).
AUTH_ALLOWED_REDIRECT_ORIGINS=

# --- Database (Prisma) ---
# Required by `prisma generate` / `prisma migrate`. Runtime validation treats
# it as optional in Sprint 1 (no DB access yet); it becomes required from
# Phase 2 onward when the API connects to Postgres.
DATABASE_URL=postgresql://trainmate:trainmate_dev@localhost:5432/trainmate

# ============================================================
# Future phases — placeholders only. NOT validated by the app yet;
# each is validated by the phase that first consumes it.
# ============================================================

# --- Phase 4 (storage) — S3-compatible (MinIO local / S3 / R2) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_AVATARS=trainmate-avatars
# S3_BUCKET_CHAT_ATTACHMENTS=trainmate-chat-attachments
