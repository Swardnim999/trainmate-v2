# ============================================================
# TrainMate v2 backend — environment template
# Copy to `.env` and adjust. `.env` is gitignored; this file is committed.
# ============================================================

# --- App ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (frontend dev server).
CORS_ORIGIN=http://localhost:5173

# --- Database (Prisma) ---
# Required by `prisma generate` / `prisma migrate`. Runtime validation treats
# it as optional in Sprint 1 (no DB access yet); it becomes required from
# Phase 2 onward when the API connects to Postgres.
DATABASE_URL=postgresql://trainmate:trainmate_dev@localhost:5432/trainmate

# ============================================================
# Future phases — placeholders only. NOT validated by the Sprint 1 app;
# each is validated by the phase that first consumes it.
# ============================================================

# --- Phase 3 (auth) ---
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# REFRESH_SECRET=

# --- Phase 4 (storage) — S3-compatible (MinIO local / S3 / R2) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_AVATARS=trainmate-avatars
# S3_BUCKET_CHAT_ATTACHMENTS=trainmate-chat-attachments
