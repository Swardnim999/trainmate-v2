# ==============================================================================
# TrainMate v2 — Free-Tier Deployment Environment Configuration Template
# ==============================================================================
# Target: Frontend on Vercel Free + Backend on Render Free + Supabase PostgreSQL
# Total Estimated Cost: $0.00 / month
#
# NEVER commit production credentials, passwords, or secrets to version control.
# Populate these variables inside the Vercel and Render dashboards directly.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings -> Environment Variables)
# ==============================================================================
# Base URL of the deployed Render backend REST API (no trailing slash).
VITE_API_URL=https://trainmate-api.onrender.com

# Base URL of the deployed Render backend Socket.IO WebSocket gateway (no trailing slash).
# Typically identical to VITE_API_URL.
VITE_SOCKET_URL=https://trainmate-api.onrender.com


# ==============================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Render Web Service Settings -> Environment Variables)
# ==============================================================================

# Core Runtime Settings
NODE_ENV=production
HOST=0.0.0.0
# PORT is automatically injected by Render (default 10000). Do not hardcode.
LOG_LEVEL=info

# Reverse Proxy Trust
# Render terminates TLS at its reverse proxy. Set to 1 so Express trusts
# the X-Forwarded-For header for accurate per-IP rate-limiting.
TRUST_PROXY_HOPS=1

# CORS & Routing Allowed Origins
# Comma-separated list of allowed origins that can make API and WebSocket requests.
# Must include your live Vercel domain (and custom domains if any).
CORS_ORIGIN=https://trainmate.vercel.app,https://trainmate-v2.vercel.app

# Public origin of THIS backend API service, used for generating email confirmation links.
API_PUBLIC_ORIGIN=https://trainmate-api.onrender.com

# Allowed redirect targets after email verification.
# If empty, falls back to CORS_ORIGIN.
AUTH_ALLOWED_REDIRECT_ORIGINS=https://trainmate.vercel.app

# Authentication & Security
# Cryptographically strong secret key used for signing and verifying JWT tokens (HS256).
# Must be at least 32 characters.
# Generate on your local machine using:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-32-plus-character-cryptographically-secure-jwt-secret-here

# Database Configuration (Supabase Free PostgreSQL)
# Supabase provides standard PostgreSQL 15/16 database infrastructure.
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or via Session Pooler (port 5432) for IPv4 networks:
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5
# Note: appending &connection_limit=5 prevents Prisma from exceeding free-tier connection quotas.
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5

# Transactional Email Configuration
# Option A: 'console' ($0/month, zero third-party accounts).
#   Verification links are logged directly to the Render service stdout logs.
# Option B: 'resend' (Free tier: 100 emails/day, 3,000/month).
#   Sign up at https://resend.com for a free API key.
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=TrainMate <noreply@trainmate.in>
