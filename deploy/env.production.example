# ==============================================================================
# TrainMate v2 — Production Environment Configuration Template
# ==============================================================================
# All values must be populated securely via AWS Secrets Manager or CI/CD secrets.
# NEVER commit real production credentials to source control.
# ==============================================================================

# Core Application Settings
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# CORS & Routing
CORS_ORIGIN=https://trainmate.in,https://app.trainmate.in
API_PUBLIC_ORIGIN=https://api.trainmate.in
AUTH_ALLOWED_REDIRECT_ORIGINS=https://trainmate.in,https://app.trainmate.in

# Database Configuration (AWS RDS PostgreSQL 17 Multi-AZ)
# DATABASE_URL routes through PgBouncer connection pooler on port 5432
DATABASE_URL=postgresql://trainmate_user:strong_password@pgbouncer.internal:5432/trainmate?sslmode=require&pgbouncer=true
# DIRECT_URL routes directly to primary RDS instance for Prisma migrations
DIRECT_URL=postgresql://trainmate_user:strong_password@rds-primary.internal:5432/trainmate?sslmode=require

# Authentication & Security
# JWT_SECRET must be at least 32 characters (generate via CSPRNG randomBytes(48).toString('base64url'))
JWT_SECRET=generate-a-secure-random-secret-here-at-least-32-chars

# Realtime & Caching (AWS ElastiCache Redis 7 Multi-AZ)
REDIS_URL=rediss://default:redis_auth_token@elasticache-cluster.internal:6379

# Transactional Email (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_1234567890abcdef
EMAIL_FROM=TrainMate <noreply@trainmate.in>

# Object Storage (AWS S3 ap-south-1)
S3_REGION=ap-south-1
S3_BUCKET_AVATARS=trainmate-prod-avatars
S3_BUCKET_ATTACHMENTS=trainmate-prod-chat-attachments
